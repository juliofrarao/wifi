# ---- Creche Segura — configuração do servidor ----
# Copie para .env e ajuste. Os valores de DAYCARE_*, VAPID_* e CONTACT_EMAIL
# só semeiam as configurações na PRIMEIRA execução; depois o painel vence.

# URL pública do app (links de e-mail, QR das carteirinhas, push).
APP_URL=https://creche.exemplo.com.br

# Porta e endereço de escuta.
PORT=3000
HOST=0.0.0.0

# true quando atrás de Caddy/Nginx/Cloudflare (usa X-Forwarded-For nos limites por IP).
TRUST_PROXY=false

# Onde ficam o banco SQLite, as fotos e os backups.
DATA_DIR=./data
# Pasta do app compilado (produção). Em desenvolvimento o Vite serve o app.
WEB_DIST=../web/dist

# Fuso horário da creche.
TZ=America/Sao_Paulo

# Nome, telefone e e-mail de contato da creche (editáveis no painel depois).
DAYCARE_NAME=Creche Municipal
DAYCARE_PHONE=
CONTACT_EMAIL=

# Administrador inicial (criado na primeira execução se não existir nenhum admin).
# O servidor RECUSA iniciar com a senha do exemplo ou com menos de 12 caracteres.
ADMIN_NAME=Direção
ADMIN_EMAIL=direcao@exemplo.com.br
ADMIN_PASSWORD=troque-esta-senha

# E-mail (SMTP). Se SMTP_HOST ficar vazio, e-mails não são enviados e os links de
# convite aparecem na tela do administrador (WhatsApp / QR).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Creche Segura <no-reply@exemplo.com.br>"
# Limite diário de e-mails (provedores gratuitos: Gmail 500, Brevo 300).
SMTP_DAILY_LIMIT=450

# Web Push: chaves VAPID geradas automaticamente na primeira execução e guardadas
# no banco. Para fixar chaves próprias, informe aqui.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:direcao@exemplo.com.br

# Janela (segundos) para desfazer um registro antes de qualquer alerta ser enviado.
NOTIFY_HOLD_SECONDS=45

# Sessões: validade deslizante e teto absoluto (dias).
SESSION_TTL_DAYS=30
SESSION_MAX_DAYS=90

# Portaria: idade máxima do diretório offline para permitir SAÍDA sem conexão (horas).
OFFLINE_CHECKOUT_MAX_AGE_HOURS=12

# Backup automático diário (02:00 no fuso da creche) e retenção.
BACKUP_KEEP_DAYS=14
# Retenção de dados (meses) usada por `npm run purge`.
RETENTION_MONTHS=24

LOG_LEVEL=info
