# ---- Creche Segura — configuração do servidor ----
# Copie para .env e ajuste.

# URL pública do app (usada nos links de e-mail, QR Code das carteirinhas e push).
APP_URL=https://creche.exemplo.com.br

# Porta e endereço de escuta do servidor.
PORT=3000
HOST=0.0.0.0

# Onde ficam o banco SQLite e as fotos.
DATA_DIR=./data

# Fuso horário da creche.
TZ=America/Sao_Paulo

# Nome e telefone da creche (podem ser alterados depois no painel).
DAYCARE_NAME=Creche Municipal
DAYCARE_PHONE=

# Administrador inicial (criado na primeira execução se não existir nenhum admin).
ADMIN_NAME=Direção
ADMIN_EMAIL=direcao@exemplo.com.br
ADMIN_PASSWORD=troque-esta-senha

# E-mail (SMTP). Se SMTP_HOST ficar vazio, os e-mails não são enviados e os links
# de convite aparecem na tela do administrador.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Creche Segura <no-reply@exemplo.com.br>"

# Web Push: as chaves VAPID são geradas automaticamente na primeira execução e
# guardadas no banco. Para fixar chaves próprias, informe aqui.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:direcao@exemplo.com.br

# Sessões (dias) e limites.
SESSION_TTL_DAYS=30
LOG_LEVEL=info
